# Exact IAM user ARNs allowed to invoke this deployed Lambda Function URL.
# Use a comma-separated list only when development needs a dedicated test user.
NUKLEIO_APP_IAM_PRINCIPAL_ARNS=arn:aws:iam::AWS_ACCOUNT_ID:user/Nukleio-App-Agent-Invoker-Dev

# File Compression Agent environment only. Keep development and production values separate.
FILE_COMPRESSION_STAGING_BUCKET=nukleio-file-compression-staging-dev
NUKLEIO_COMPRESSION_CALLER_ARNS=arn:aws:iam::AWS_ACCOUNT_ID:user/Nukleio-App-Agent-Invoker-Dev,arn:aws:iam::AWS_ACCOUNT_ID:role/Nukleio-Professional-Headshot-Agent-Dev,arn:aws:iam::AWS_ACCOUNT_ID:role/Nukleio-Resume-Agent-Dev
GHOSTSCRIPT_BINARY_PATH=/opt/bin/gs
